# Remote fallback server environment example.
# Copy this file to `server/.env` and fill in real values before running the server.

# Required only when the remote fallback should call Claude.
# If this value is missing, JudgeService returns UNKNOWN with type `remote_not_configured`.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional. Used by server/judge_service.py when calling Claude.
ANTHROPIC_MODEL=claude-3-5-haiku-latest
