# Gradle/Kotlin build caches and outputs
.gradle/
.kotlin/
build/
out/

# Compiled artifacts -- keep the wrapper jar, it's what makes ./gradlew work
# without Gradle installed
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar
*.war
*.ear

# IDE project files
.idea/
*.iml
.vscode/
.github/modernize/

# Android Studio's Espresso test screenshot/video output
captures/

# macOS Finder metadata
.DS_Store

# Python (model/, server/)
__pycache__/
*.py[cod]
.env
.venv/

# Local machine-specific Android SDK path, never shared
local.properties
